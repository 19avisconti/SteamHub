<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>SteamHub</string>
	<key>CFBundleDisplayName</key>
	<string>SteamHub</string>
	<key>CFBundleIdentifier</key>
	<string>com.visconti.SteamHub</string>
	<key>CFBundleExecutable</key>
	<string>SteamHub</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Shown verbatim in the macOS permission prompt. Without these the system asks
	     with no explanation, which reads as suspicious for an app nobody signed. -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>SteamHub looks here for git repositories you have already cloned, so it can tell you when a teammate pushes.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>SteamHub looks here for git repositories you have already cloned, so it can tell you when a teammate pushes.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>SteamHub looks here for git repositories you have already cloned, so it can tell you when a teammate pushes.</string>
</dict>
</plist>
